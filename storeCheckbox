<body>
   
    <p id="text" style="display: none;">WARNINGCaps Lock is on!</p>
<script>
    var input = document.getElementById("myInput");
    var text = localStorage.getItem("text");
    input.addEventListener("keyup",function(event){
        if(event.getModifierState("CapsLock")){
            text.style.display = "block";
        } else {
            text.style.display = "none";
        }
    });
</script>

<div class ="checkbox1">
     <div id="checkbox1">
<label for="myCheckbox1"></label>
<input type="checkbox" id="myCheckbox1" onclick="myFunction()">

<script> function myFunction() {var checkbox = document.getElementById("myCheckbox1");
    if(checkbox.checked== true){
        text.style.display = "block";
    } else {
        text.style.display = "none";
    }
 } </script>
